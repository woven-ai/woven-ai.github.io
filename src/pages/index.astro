---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Transition from '../components/Transition.astro';
import Deficit from '../components/Deficit.astro';
import Transfer from '../components/Transfer.astro';
import Primitive from '../components/Primitive.astro';
import Recipe from '../components/Recipe.astro';
import AuthorsCitation from '../components/AuthorsCitation.astro';

import '../styles/section.css';
import '../styles/hero.css';
import '../styles/authors.css';
import '../styles/resources.css';

const pageTitle = "WOVEN: Weaving Visual World Modeling into Multimodal LLMs";
---
<Layout title={pageTitle}>
  <Hero />
  <Transition />
  <section id="findings" class="content-section">
    <div class="section-container">
      <h2 class="section-title">Findings</h2>
      <p class="findings-sub">Click each question to expand the evidence.</p>
      <div class="rq-list">
        <Deficit />
        <Transfer />
        <Primitive />
        <Recipe />
      </div>
    </div>
  </section>
  <AuthorsCitation />
  <script>
    // Open the question card a link points to (for example, the headline numbers in the hero).
    const openTarget = () => {
      const el = location.hash ? document.getElementById(location.hash.slice(1)) : null;
      if (el && el.tagName === 'DETAILS') { (el as HTMLDetailsElement).open = true; el.scrollIntoView({ block: 'start' }); }
    };
    window.addEventListener('hashchange', openTarget);
    openTarget();
  </script>
</Layout>
