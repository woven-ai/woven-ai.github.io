---
// Transition.astro: the Method section — capability, data, and training subsets.
import { FAMILIES } from '../data/woven';
---
<section id="method" class="content-section">
  <div class="section-container">
    <h2 class="section-title">Method</h2>

    <div class="m-card">
      <div class="m-head"><span class="pill">Formalization</span><h3>Visual transition reasoning</h3></div>
      <p class="m-text">Infer the unobserved part of a transition (s, a, s′) from its observed parts.</p>
      <div class="fam-grid">
        {FAMILIES.map((f) => (
          <div class="fam" style={`--fam:${f.color}`}>
            <div class="fam-name">{f.name}</div>
            {f.ops.map((o) => (
              <div class="fam-op"><span class="op-n">{o.name}</span><span class="op-d" set:html={o.dist} /></div>
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="m-card">
      <div class="m-head"><span class="pill">Data</span><h3>Controlled transition rollouts</h3></div>
      <p class="m-text">Rollouts of Wan2.2-I2V-A14B, several from the same initial state, become four-option questions; every wrong option is labeled with its error type.</p>
      <figure class="m-figure">
        <a href="figures/taxonomy.jpg" target="_blank" rel="noopener" class="zoom-link" title="Open full-size image"><img src="figures/taxonomy.jpg" alt="The WOVEN taxonomy. Left: the passive physical event type with its eight principles and the four agent-driven action types. Middle: the eight reasoning types in four families, each marking which element of (s, a, s′) the question asks for. Right: example scenes; restaurant and beach are held out." width="2000" height="1051" loading="lazy" /></a>
      </figure>
      <div class="chips"><span>36,076 items</span><span>20 scene types</span><span>5 action types</span><span>8 reasoning types</span></div>
    </div>

    <div class="m-card">
      <div class="m-head"><span class="pill">Training</span><h3>Fullmix, and controlled subsets</h3></div>
      <p class="m-text">11 subsets of about 2,000 items, each pairing one action type with one reasoning family, train Qwen2.5-VL-3B-Instruct with SFT, then GRPO.</p>
      <div class="chips"><span>Replicated across scales and model families</span></div>
    </div>
  </div>
</section>

<style>
  .fam-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.8rem; margin-top: 0.9rem; }
  .fam { border-radius: 10px; background: #f7f8fb; border-top: 3px solid var(--fam); padding: 0.7rem 0.8rem; display: flex; flex-direction: column; gap: 0.45rem; }
  .fam-name { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--fam); }
  .fam-op { display: flex; flex-direction: column; gap: 0.1rem; }
  .op-n { font-size: 0.9rem; font-weight: 600; color: #1c2a3a; }
  .op-d { font-family: 'Times New Roman', Times, serif; font-style: italic; font-size: 0.98rem; color: #333; }
  .op-d :global(b) { font-style: normal; font-weight: 700; }
  @media (max-width: 900px) { .fam-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .fam-grid { grid-template-columns: 1fr; } }
</style>
