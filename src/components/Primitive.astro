---
// Primitive.astro: RQ3 — a primitive, or a collection of task-specific effects?
import { DOSE, subsetName } from '../data/woven';

// Schematic: two explanations of the gains (left: task-specific effects; right: a shared primitive).
const SRC = ['Camera motion', 'Manipulation', 'Passive physics'];
const DST = ['Spatial', 'Embodied', 'Physical'];
const BW = 132, BH = 40, YS = [52, 116, 180];
const PW = 112, PH = 92, PX = 164, PY = 102;

// Dose-response scatter: WOVEN gain after SFT against the mean external gain, one dot per subset.
const SW = 520, SH = 300, SL = 62, SR = 16, ST = 14, SB = 50;
const XMAX = 26, YMAX = 3.5;
const sx = (x: number) => SL + (x / XMAX) * (SW - SL - SR);
const sy = (y: number) => SH - SB - (y / YMAX) * (SH - SB - ST);
const xs = DOSE.map((d) => d.w), ys = DOSE.map((d) => d.e);
const mean = (a: number[]) => a.reduce((s, v) => s + v, 0) / a.length;
const mx = mean(xs), my = mean(ys);
const sxy = xs.reduce((s, x, i) => s + (x - mx) * (ys[i] - my), 0);
const sxx = xs.reduce((s, x) => s + (x - mx) ** 2, 0);
const syy = ys.reduce((s, y) => s + (y - my) ** 2, 0);
const slope = sxy / sxx, icpt = my - slope * mx;
const r = sxy / Math.sqrt(sxx * syy);
const FX0 = 4, FX1 = 25.5;

// Evidence schematics.
const ACTS = ['Camera motion', 'Object inspection', 'Navigation', 'Object manipulation', 'Passive physics'];
// Content control on SAT (paper appendix, mean of 3 seeds).
const CC = [
  { l: ['Base'], v: 39.3, cls: 'base' },
  { l: ['WOVEN'], v: 63.3, cls: 'real' },
  { l: ['Scrambled'], v: 35.1, cls: 'ctl' },
  { l: ['Mirrored'], v: 37.8, cls: 'ctl' },
  { l: ['Other', '4-option data'], v: 44.0, cls: 'ctl' },
];
const CW = 440, CH = 270, CL = 50, CR = 8, CT = 18, CB = 50;
const cy = (v: number) => CH - CB - (v / 70) * (CH - CB - CT);
const CSLOT = (CW - CL - CR) / CC.length, CBW = CSLOT * 0.56;
const cx = (k: number) => CL + CSLOT * k + (CSLOT - CBW) / 2;
---

<details class="rq" id="primitive" open>
  <summary>
    <span class="rq-tag">RQ3</span>
    <span class="rq-q">A primitive, or just a collection of task-specific effects?</span>
    <span class="rq-a">A primitive — different sources of supervision build the same capability, and broad downstream gains result from it (r = 0.86 across the 11 subsets).</span>
    <div class="schema">
      <figure class="schema-panel">
        <svg viewBox="0 0 440 236" role="img" aria-label="Task-specific effects: each supervision source improves only its own domain">
          <defs><marker id="ah-gray" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#a3acbb" /></marker></defs>
          <text x="86" y="26" class="col-h" text-anchor="middle">Supervision sources</text>
          <text x="354" y="26" class="col-h" text-anchor="middle">Downstream domains</text>
          {YS.map((y, k) => (
            <g>
              <rect x="20" y={y} width={BW} height={BH} rx="9" class="box src" />
              <text x={20 + BW / 2} y={y + BH / 2 + 5} class="box-t">{SRC[k]}</text>
              <rect x={440 - 20 - BW} y={y} width={BW} height={BH} rx="9" class="box dst" />
              <text x={440 - 20 - BW / 2} y={y + BH / 2 + 5} class="box-t">{DST[k]}</text>
              <line x1={20 + BW + 8} y1={y + BH / 2} x2={440 - 20 - BW - 10} y2={y + BH / 2} class="arrow gray" marker-end="url(#ah-gray)" />
            </g>
          ))}
        </svg>
        <figcaption class="verdict no"><span class="mark">✕</span>A collection of task-specific effects</figcaption>
      </figure>
      <figure class="schema-panel">
        <svg viewBox="0 0 440 236" role="img" aria-label="A shared primitive: every supervision source builds visual transition reasoning, which helps every domain">
          <defs><marker id="ah-blue" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#2453c4" /></marker></defs>
          <text x="6" y="26" class="col-h" text-anchor="start">Supervision sources</text>
          <text x="434" y="26" class="col-h" text-anchor="end">Downstream domains</text>
          {YS.map((y, k) => (
            <g>
              <rect x="6" y={y} width={120} height={BH} rx="9" class="box src" />
              <text x={66} y={y + BH / 2 + 5} class="box-t">{SRC[k]}</text>
              <rect x={314} y={y} width={120} height={BH} rx="9" class="box dst" />
              <text x={374} y={y + BH / 2 + 5} class="box-t">{DST[k]}</text>
              <line x1={130} y1={y + BH / 2} x2={PX - 6} y2={PY + PH / 2 + (k - 1) * 22} class="arrow blue" marker-end="url(#ah-blue)" />
              <line x1={PX + PW + 4} y1={PY + PH / 2 + (k - 1) * 22} x2={308} y2={y + BH / 2} class="arrow blue" marker-end="url(#ah-blue)" />
            </g>
          ))}
          <rect x={PX} y={PY} width={PW} height={PH} rx="14" class="prim" />
          <text x={PX + PW / 2} y={PY + 32} class="prim-t">Visual</text>
          <text x={PX + PW / 2} y={PY + 51} class="prim-t">transition</text>
          <text x={PX + PW / 2} y={PY + 70} class="prim-t">reasoning</text>
        </svg>
        <figcaption class="verdict yes"><span class="mark">✓</span>A shared primitive</figcaption>
      </figure>
    </div>
  </summary>
  <div class="rq-body">
    <section class="ev">
      <div class="ev-head"><span class="ev-n">a</span><h3 class="ev-t">Different sources improve the same capability</h3></div>
      <div class="egrid three">
        <article class="ecard">
          <h4>Across action types</h4>
          <svg viewBox="0 0 276 176" role="img" aria-label="Training on one action type also improves the four action types it does not train on">
            <defs><marker id="ea" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#2453c4" /></marker></defs>
            <rect x="4" y="54" width="86" height="48" rx="10" class="s-src" />
            <text x="47" y="74" class="s-sm">Train on one</text>
            <text x="47" y="91" class="s-b">action type</text>
            <text x="47" y="138" class="s-big">43 / 44</text>
            <text x="47" y="155" class="s-sm">untrained cases</text>
            <text x="47" y="168" class="s-sm">improve</text>
            {ACTS.map((a, k) => (
              <g>
                <line x1="92" y1="78" x2="116" y2={6 + k * 34 + 12} class="s-arr" marker-end="url(#ea)" />
                <rect x="120" y={6 + k * 34} width="116" height="24" rx="7" class={k === 0 ? 's-box trained' : 's-box'} />
                <text x="178" y={6 + k * 34 + 16} class="s-t">{a}</text>
                {k === 0 ? <text x="256" y={6 + k * 34 + 15.5} class="s-tag">trained</text> : <text x="250" y={6 + k * 34 + 17} class="s-up">▲</text>}
              </g>
            ))}
          </svg>
          <p>Every subset also improves the action types it does not train on.</p>
        </article>
        <article class="ecard">
          <h4>Across reasoning types</h4>
          <svg viewBox="0 0 276 176" role="img" aria-label="Training on forward prediction alone raises counterfactual substitution and removal; forward and inverse questions are answered right or wrong together after training">
            <defs><marker id="eb" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#2453c4" /></marker></defs>
            <rect x="4" y="14" width="88" height="58" rx="10" class="s-src" />
            <text x="48" y="32" class="s-sm">Train only on</text>
            <text x="48" y="49" class="s-b">forward</text>
            <text x="48" y="64" class="s-b">prediction</text>
            <text x="198" y="10" class="s-sm">Counterfactual</text>
            <line x1="94" y1="36" x2="118" y2="30" class="s-arr" marker-end="url(#eb)" />
            <line x1="94" y1="50" x2="118" y2="62" class="s-arr" marker-end="url(#eb)" />
            <rect x="122" y="17" width="150" height="26" rx="7" class="s-box" />
            <text x="132" y="34.5" class="s-t ta-s">substitution</text><text x="264" y="35" class="s-val ta-e">+48</text>
            <rect x="122" y="49" width="150" height="26" rx="7" class="s-box" />
            <text x="132" y="66.5" class="s-t ta-s">removal</text><text x="264" y="67" class="s-val ta-e">+25</text>
            <line x1="4" x2="272" y1="90" y2="90" class="s-div" />
            <text x="138" y="112" class="s-note blue">right or wrong together</text>
            <rect x="6" y="120" width="84" height="28" rx="7" class="s-box" /><text x="48" y="138.5" class="s-t">Forward</text>
            <rect x="186" y="120" width="84" height="28" rx="7" class="s-box" /><text x="228" y="138.5" class="s-t">Inverse</text>
            <line x1="96" y1="134" x2="180" y2="134" class="s-arr" marker-start="url(#eb)" marker-end="url(#eb)" />
            <text x="138" y="168" class="s-note">independent before training</text>
          </svg>
          <p>Training on forward prediction alone raises counterfactual substitution by 48 points and removal by 25. After training, the forward and inverse questions about one transition are answered right or wrong together.</p>
        </article>
        <article class="ecard">
          <h4>Not a shortcut</h4>
          <svg viewBox="0 0 276 176" role="img" aria-label="With the unchanged-scene option removed the gain remains; counterfactual removal, whose answer is the unchanged scene, also improves">
            <defs><marker id="ec" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#8a94a6" /></marker></defs>
            <text x="4" y="12" class="s-sm ta-s">Unchanged-scene option removed</text>
            {['A', 'B', 'C'].map((l, k) => (<g><rect x={4 + k * 26} y="22" width="22" height="22" rx="5" class="s-opt" /><text x={15 + k * 26} y="37.5" class="s-t">{l}</text></g>))}
            <rect x="82" y="22" width="34" height="22" rx="5" class="s-opt gone" /><text x="99" y="37" class="s-same">same</text>
            <line x1="80" y1="46" x2="118" y2="20" class="s-x" />
            <line x1="122" y1="33" x2="140" y2="33" class="s-arr gray" marker-end="url(#ec)" />
            <text x="146" y="28" class="s-sm ta-s">Counterfactual substitution</text>
            <text x="146" y="46" class="s-val ta-s">28.5 → 93.3</text>
            <line x1="4" x2="272" y1="66" y2="66" class="s-div" />
            <text x="4" y="86" class="s-sm ta-s">Answer is the unchanged scene</text>
            {['A', 'B', 'C'].map((l, k) => (<g><rect x={4 + k * 26} y="96" width="22" height="22" rx="5" class="s-opt" /><text x={15 + k * 26} y="111.5" class="s-t">{l}</text></g>))}
            <rect x="82" y="96" width="34" height="22" rx="5" class="s-opt right" /><text x="99" y="111" class="s-same ok">same ✓</text>
            <line x1="122" y1="107" x2="140" y2="107" class="s-arr gray" marker-end="url(#ec)" />
            <text x="146" y="102" class="s-sm ta-s">Counterfactual removal</text>
            <text x="146" y="120" class="s-val ta-s">18.6 → up to 49.6</text>
            <line x1="4" x2="272" y1="140" y2="140" class="s-div" />
            <text x="138" y="164" class="s-note">Rules out "pick the frame that changed"</text>
          </svg>
          <p>Without the unchanged-scene option, the gain remains. Counterfactual removal, whose answer is the unchanged scene, also improves.</p>
        </article>
      </div>
    </section>

    <section class="ev">
      <div class="ev-head"><span class="ev-n">b</span><h3 class="ev-t">The downstream gains result from that capability</h3></div>
      <div class="egrid two">
        <article class="ecard">
          <h4>A common component</h4>
          <div class="cmat">
            <img src="figures/profiles_raw.png" alt="Correlation matrix of the 11 subsets' transfer profiles; every cell is positive." width="506" height="506" loading="lazy" />
            <div class="cmat-key"><span>0</span><span class="cmat-bar"></span><span>1</span><span class="cmat-lab">correlation</span></div>
          </div>
          <p>The transfer profiles of the 11 subsets are positively correlated in all 55 pairs (mean 0.56). The first principal component explains 75% of the variance and tracks the WOVEN gains (r = 0.92–0.93).</p>
        </article>
        <article class="ecard">
          <h4>More gain on WOVEN, more gain downstream</h4>
          <svg viewBox={`0 0 ${SW} ${SH}`} role="img" aria-label={`Mean external gain against WOVEN gain for the 11 subsets; r = ${r.toFixed(2)}`}>
            {[0, 1, 2, 3].map((t) => (
              <g>
                <line x1={SL} x2={SW - SR} y1={sy(t)} y2={sy(t)} class="grid" />
                <text x={SL - 8} y={sy(t) + 4} class="tick" text-anchor="end">{t}</text>
              </g>
            ))}
            {[0, 5, 10, 15, 20, 25].map((t) => (<text x={sx(t)} y={SH - SB + 18} class="tick" text-anchor="middle">{t}</text>))}
            <line x1={SL} x2={SW - SR} y1={sy(0)} y2={sy(0)} class="axis" />
            <line x1={sx(FX0)} y1={sy(icpt + slope * FX0)} x2={sx(FX1)} y2={sy(icpt + slope * FX1)} class="fit" />
            {DOSE.map((d) => (
              <circle cx={sx(d.w)} cy={sy(d.e)} r="6.5" class="pt"><title>{`${subsetName(d.s)}: +${d.w.toFixed(1)} on WOVEN, +${d.e.toFixed(2)} external`}</title></circle>
            ))}
            <text x={sx(1)} y={sy(3.15)} class="r-lab">r = {r.toFixed(2)}</text>
            <text x={(SL + SW - SR) / 2} y={SH - 8} class="ax-title" text-anchor="middle">Gain in WOVEN accuracy after SFT (points)</text>
            <text transform={`translate(16 ${(ST + SH - SB) / 2}) rotate(-90)`} class="ax-title" text-anchor="middle">Mean external gain (points)</text>
          </svg>
          <p>Across the 11 subsets, r = 0.86 (Spearman 0.86; 0.84–0.92 leaving out any one subset; positive within the temporal and the non-temporal subsets).</p>
        </article>
        <article class="ecard">
          <h4>Content control</h4>
          <svg viewBox={`0 0 ${CW} ${CH}`} role="img" aria-label="SAT accuracy after training on real WOVEN data and three controls">
            {[0, 20, 40, 60].map((t) => (
              <g>
                <line x1={CL} x2={CW - CR} y1={cy(t)} y2={cy(t)} class="grid" />
                <text x={CL - 8} y={cy(t) + 4} class="tick" text-anchor="end">{t}</text>
              </g>
            ))}
            {CC.map((c, k) => (
              <g>
                <rect x={cx(k)} y={cy(c.v)} width={CBW} height={cy(0) - cy(c.v)} rx="4" class={`cbar ${c.cls}`} />
                <text x={cx(k) + CBW / 2} y={cy(c.v) - 6} class="cval" text-anchor="middle">{c.v.toFixed(1)}</text>
                {c.l.map((t, i) => (<text x={cx(k) + CBW / 2} y={cy(0) + 17 + i * 14} class="clab" text-anchor="middle">{t}</text>))}
              </g>
            ))}
            <line x1={CL} x2={CW - CR} y1={cy(CC[0].v)} y2={cy(CC[0].v)} class="cbase" />
            <line x1={CL} x2={CW - CR} y1={cy(0)} y2={cy(0)} class="axis" />
            <text transform={`translate(15 ${(CT + CH - CB) / 2}) rotate(-90)`} class="ax-title" text-anchor="middle">SAT accuracy (%)</text>
          </svg>
          <p>The same question format with scrambled or mirrored action–outcome pairs, or other four-option data, does not reproduce the gains.</p>
        </article>
        <article class="ecard">
          <h4>Specificity</h4>
          <svg viewBox="0 0 420 210" role="img" aria-label="All 22 transition benchmarks improve; none of the 4 static-perception or general video QA benchmarks gains more than 2 points">
            <rect x="12" y="20" width="186" height="150" rx="12" class="sp-yes" />
            <text x="105" y="48" class="sp-h yes">Benchmarks with</text>
            <text x="105" y="64" class="sp-h yes">visual transitions</text>
            <text x="105" y="112" class="sp-big yes">22 / 22</text>
            <text x="105" y="138" class="sp-s">improve</text>
            <rect x="222" y="20" width="186" height="150" rx="12" class="sp-no" />
            <text x="315" y="48" class="sp-h">Static perception,</text>
            <text x="315" y="64" class="sp-h">general video QA</text>
            <text x="315" y="112" class="sp-big">0 / 4</text>
            <text x="315" y="138" class="sp-s">gain more than 2 points</text>
          </svg>
          <p>The gains appear only where the task involves a visual transition.</p>
        </article>
      </div>
    </section>

    <section class="ev plus">
      <div class="ev-head"><span class="ev-n">+</span><h3 class="ev-t">Further test of causality by intervention</h3></div>
      <p class="ev-x">With the training budget fixed at 2,000 items, replacing 30–50% of a benchmark’s own training items with WOVEN items keeps accuracy comparable (blue), above simply deleting them (orange dashed).</p>
      <figure class="ev-fig">
        <a href="figures/substitution.png" target="_blank" rel="noopener" class="zoom-link" title="Open full-size image"><img src="figures/substitution.png" alt="Three panels (SAT, ActionEQA, CLEVRER) plotting accuracy against the share p of task-specific training data replaced by WOVEN items under a fixed 2,000-item budget. Accuracy stays near the p = 0 level up to 30 to 50 percent replacement and stays above the deletion control." width="2000" height="573" loading="lazy" /></a>
      </figure>
    </section>
  </div>
</details>

<style>
