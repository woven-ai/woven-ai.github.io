---
// Primitive.astro: RQ3 — a primitive, or a collection of task-specific effects?
import { DOSE, subsetName } from '../data/woven';

// Schematic: two explanations of the gains (left: task-specific effects; right: a shared primitive).
const SRC = ['Camera motion', 'Manipulation', 'Passive physics'];
const DST = ['Spatial', 'Embodied', 'Physical'];
const BW = 132, BH = 40, YS = [52, 116, 180];
const PW = 112, PH = 92, PX = 164, PY = 102;

// Dose-response scatter: WOVEN gain after SFT against the mean external gain, one dot per subset.
const SW = 520, SH = 300, SL = 62, SR = 16, ST = 14, SB = 50;
const XMAX = 26, YMAX = 3.5;
const sx = (x: number) => SL + (x / XMAX) * (SW - SL - SR);
const sy = (y: number) => SH - SB - (y / YMAX) * (SH - SB - ST);
const xs = DOSE.map((d) => d.w), ys = DOSE.map((d) => d.e);
const mean = (a: number[]) => a.reduce((s, v) => s + v, 0) / a.length;
const mx = mean(xs), my = mean(ys);
const sxy = xs.reduce((s, x, i) => s + (x - mx) * (ys[i] - my), 0);
const sxx = xs.reduce((s, x) => s + (x - mx) ** 2, 0);
const syy = ys.reduce((s, y) => s + (y - my) ** 2, 0);
const slope = sxy / sxx, icpt = my - slope * mx;
const r = sxy / Math.sqrt(sxx * syy);
const FX0 = 4, FX1 = 25.5;

// Grid of action types x reasoning types for the spread schematic (trained cell at TR, TC).
const GROWS = 5, GCOLS = 6, GC = 22, GP = 26, GY = 40, TR = 1, TC = 2;
const GW = GCOLS * GP - (GP - GC), GH = GROWS * GP - (GP - GC);
const GRID = Array.from({ length: GROWS * GCOLS }, (_, k) => [Math.floor(k / GCOLS), k % GCOLS]);

// Evidence schematics.
// Content control (SAT, paper appendix, mean of 3 seeds): no training, correct transitions,
// the same format with wrong transitions (scrambled, mirrored), and other multiple-choice data.
const CW = 560, CH = 270, CL = 54, CR = 10, CT = 18, CB = 52, CBW = 52;
const cy = (v: number) => CH - CB - (v / 70) * (CH - CB - CT);
const CC = [
  { x: 92, v: 39.3, cls: 'base' },
  { x: 196, v: 63.3, cls: 'real' },
  { x: 300, v: 35.1, cls: 'ctl' },
  { x: 358, v: 37.8, cls: 'ctl' },
  { x: 462, v: 44.0, cls: 'ctl' },
];
const CG = [
  { x: 118, l: ['No training'] },
  { x: 222, l: ['Correct transitions'] },
  { x: 355, l: ['Same format,', 'wrong transitions'] },
  { x: 488, l: ['Other multiple-', 'choice data'] },
];
---

<details class="rq" id="primitive" open>
  <summary>
    <span class="rq-tag">RQ3</span>
    <span class="rq-q">A primitive, or just a collection of task-specific effects?</span>
    <span class="rq-a">A primitive — different sources of supervision build the same capability, and broad downstream gains result from it.</span>
    <div class="schema">
      <figure class="schema-panel">
        <svg viewBox="0 0 440 236" role="img" aria-label="Task-specific effects: each supervision source improves only its own domain">
          <defs><marker id="ah-gray" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#a3acbb" /></marker></defs>
          <text x="86" y="26" class="col-h" text-anchor="middle">Supervision sources</text>
          <text x="354" y="26" class="col-h" text-anchor="middle">Downstream domains</text>
          {YS.map((y, k) => (
            <g>
              <rect x="20" y={y} width={BW} height={BH} rx="9" class="box src" />
              <text x={20 + BW / 2} y={y + BH / 2 + 5} class="box-t">{SRC[k]}</text>
              <rect x={440 - 20 - BW} y={y} width={BW} height={BH} rx="9" class="box dst" />
              <text x={440 - 20 - BW / 2} y={y + BH / 2 + 5} class="box-t">{DST[k]}</text>
              <line x1={20 + BW + 8} y1={y + BH / 2} x2={440 - 20 - BW - 10} y2={y + BH / 2} class="arrow gray" marker-end="url(#ah-gray)" />
            </g>
          ))}
        </svg>
        <figcaption class="verdict no"><span class="mark">✕</span>A collection of task-specific effects</figcaption>
      </figure>
      <figure class="schema-panel">
        <svg viewBox="0 0 440 236" role="img" aria-label="A shared primitive: every supervision source builds visual transition reasoning, which helps every domain">
          <defs><marker id="ah-blue" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#2453c4" /></marker></defs>
          <text x="6" y="26" class="col-h" text-anchor="start">Supervision sources</text>
          <text x="434" y="26" class="col-h" text-anchor="end">Downstream domains</text>
          {YS.map((y, k) => (
            <g>
              <rect x="6" y={y} width={120} height={BH} rx="9" class="box src" />
              <text x={66} y={y + BH / 2 + 5} class="box-t">{SRC[k]}</text>
              <rect x={314} y={y} width={120} height={BH} rx="9" class="box dst" />
              <text x={374} y={y + BH / 2 + 5} class="box-t">{DST[k]}</text>
              <line x1={130} y1={y + BH / 2} x2={PX - 6} y2={PY + PH / 2 + (k - 1) * 22} class="arrow blue" marker-end="url(#ah-blue)" />
              <line x1={PX + PW + 4} y1={PY + PH / 2 + (k - 1) * 22} x2={308} y2={y + BH / 2} class="arrow blue" marker-end="url(#ah-blue)" />
            </g>
          ))}
          <rect x={PX} y={PY} width={PW} height={PH} rx="14" class="prim" />
          <text x={PX + PW / 2} y={PY + 32} class="prim-t">Visual</text>
          <text x={PX + PW / 2} y={PY + 51} class="prim-t">transition</text>
          <text x={PX + PW / 2} y={PY + 70} class="prim-t">reasoning</text>
        </svg>
        <figcaption class="verdict yes"><span class="mark">✓</span>A shared primitive</figcaption>
      </figure>
    </div>
  </summary>
  <div class="rq-body">
    <section class="ev">
      <div class="ev-head"><span class="ev-n">A</span><h3 class="ev-t">Different sources improve the same capability? <span class="yes">— Yes</span></h3></div>
      <div class="items">
        <div class="item">
          <h4 class="it"><span class="it-n">A.1</span>Each source improves far beyond the slice it trains on</h4>
          <svg viewBox="0 0 600 236" role="img" aria-label="If each source learned only its own slice, only the trained cell would improve; instead, gains appear across the whole grid">
            {[{ cx: 150, lit: false }, { cx: 450, lit: true }].map((p) => (
              <g>
                <text x={p.cx} y="20" class="s-lab">{p.lit ? 'What we observe' : 'If each source learned only its own slice'}</text>
                <text transform={`translate(${p.cx - GW / 2 - 12} ${GY + GH / 2}) rotate(-90)`} class="g-ax">Kind of transition</text>
                <text x={p.cx} y={GY + GH + 18} class="g-ax">Kind of question</text>
                {GRID.map(([r, c]) => (
                  <rect x={p.cx - GW / 2 + c * GP} y={GY + r * GP} width={GC} height={GC} rx="4"
                    class={r === TR && c === TC ? 'g-cell on' : p.lit ? 'g-cell lit' : 'g-cell'} />
                ))}
                <text x={p.cx} y="226" class={p.lit ? 's-res' : 's-no'}>{p.lit ? '✓ gains across the grid' : '✕ only the trained cell — ruled out'}</text>
              </g>
            ))}
            <line x1="300" x2="300" y1="8" y2="214" class="s-div" />
          </svg>
          <div class="g-key"><span class="k on"></span>trained<span class="k lit"></span>improved</div>
        </div>
        <div class="item">
          <h4 class="it"><span class="it-n">A.2</span>Questions derived from the same transition become correlated</h4>
          <svg viewBox="0 0 600 200" role="img" aria-label="Two questions derived from one transition: answered independently before training, correlated after training">
            <defs><marker id="m3" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#2453c4" /></marker>
              <marker id="m3g" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#8a94a6" /></marker></defs>
            {[{ cx: 150, after: false }, { cx: 450, after: true }].map((p) => (
              <g>
                <text x={p.cx} y="20" class="s-lab">{p.after ? 'After training' : 'Before training'}</text>
                <rect x={p.cx - 48} y="34" width="36" height="28" rx="6" class="sc-frame" />
                <rect x={p.cx - 42} y="47" width="10" height="10" rx="2" class="sc-obj" />
                <line x1={p.cx - 8} y1="48" x2={p.cx + 6} y2="48" class="s-arr gray" marker-end="url(#m3g)" />
                <rect x={p.cx + 12} y="34" width="36" height="28" rx="6" class="sc-frame" />
                <rect x={p.cx + 32} y="47" width="10" height="10" rx="2" class="sc-obj" />
                <text x={p.cx} y="80" class="s-note">one transition</text>
                <line x1={p.cx - 20} y1="88" x2={p.cx - 75} y2="112" class="q-tie" />
                <line x1={p.cx + 20} y1="88" x2={p.cx + 75} y2="112" class="q-tie" />
                <rect x={p.cx - 120} y="112" width="90" height="30" rx="8" class="s-box" /><text x={p.cx - 75} y="132" class="s-t">Question 1</text>
                <rect x={p.cx + 30} y="112" width="90" height="30" rx="8" class="s-box" /><text x={p.cx + 75} y="132" class="s-t">Question 2</text>
                {p.after
                  ? <line x1={p.cx - 24} y1="127" x2={p.cx + 24} y2="127" class="s-arr" marker-start="url(#m3)" marker-end="url(#m3)" />
                  : <line x1={p.cx - 26} y1="127" x2={p.cx + 26} y2="127" class="s-dash" />}
                <text x={p.cx} y="172" class={p.after ? 's-note blue' : 's-note'}>{p.after ? 'correlated' : 'independent'}</text>
              </g>
            ))}
            <line x1="300" x2="300" y1="8" y2="180" class="s-div" />
          </svg>
        </div>
        <div class="item">
          <h4 class="it"><span class="it-n">A.3</span>The gains are not a shortcut</h4>
          <p class="it-more">See details in <a href="https://arxiv.org/abs/2610.12417" target="_blank" rel="noopener">our paper</a>.</p>
        </div>
      </div>
    </section>

    <section class="ev">
      <div class="ev-head"><span class="ev-n">B</span><h3 class="ev-t">The downstream gains result from that capability? <span class="yes">— Yes</span></h3></div>
      <div class="items">
        <div class="item">
          <h4 class="it"><span class="it-n">B.1</span>All sources improve largely the same downstream benchmarks</h4>
          <div class="cmat">
            <img src="figures/profiles_raw.png" alt="Correlation matrix of the 11 subsets' transfer profiles; every cell is positive." width="506" height="506" loading="lazy" />
            <div class="cmat-side">
              <p class="cmat-big">55 / 55</p>
              <p class="cmat-txt">pairs of sources with positively correlated transfer</p>
              <div class="cmat-key"><span>0</span><span class="cmat-bar"></span><span>1</span></div>
            </div>
          </div>
        </div>
        <div class="item">
          <h4 class="it"><span class="it-n">B.2</span>Sources that improve the capability more transfer more</h4>
          <svg viewBox={`0 0 ${SW} ${SH}`} role="img" aria-label={`Mean downstream gain against WOVEN gain for the 11 subsets; r = ${r.toFixed(2)}`}>
            {[0, 1, 2, 3].map((t) => (
              <g>
                <line x1={SL} x2={SW - SR} y1={sy(t)} y2={sy(t)} class="grid" />
                <text x={SL - 8} y={sy(t) + 4} class="tick" text-anchor="end">{t}</text>
              </g>
            ))}
            {[0, 5, 10, 15, 20, 25].map((t) => (<text x={sx(t)} y={SH - SB + 18} class="tick" text-anchor="middle">{t}</text>))}
            <line x1={SL} x2={SW - SR} y1={sy(0)} y2={sy(0)} class="axis" />
            <line x1={sx(FX0)} y1={sy(icpt + slope * FX0)} x2={sx(FX1)} y2={sy(icpt + slope * FX1)} class="fit" />
            {DOSE.map((d) => (<circle cx={sx(d.w)} cy={sy(d.e)} r="6.5" class="pt" />))}
            <text x={sx(1)} y={sy(3.15)} class="r-lab">r = {r.toFixed(2)}</text>
            <text x={(SL + SW - SR) / 2} y={SH - 8} class="ax-title" text-anchor="middle">Gain on WOVEN (points)</text>
            <text transform={`translate(16 ${(ST + SH - SB) / 2}) rotate(-90)`} class="ax-title" text-anchor="middle">Mean downstream gain (points)</text>
          </svg>
        </div>
        <div class="item">
          <h4 class="it"><span class="it-n">B.3</span>Only correct transitions produce the gains</h4>
          <svg viewBox={`0 0 ${CW} ${CH}`} role="img" aria-label="Downstream accuracy after training on correct transitions, on the same format with wrong transitions, and on other multiple-choice data">
            {[0, 20, 40, 60].map((t) => (
              <g>
                <line x1={CL} x2={CW - CR} y1={cy(t)} y2={cy(t)} class="grid" />
                <text x={CL - 8} y={cy(t) + 4} class="tick" text-anchor="end">{t}</text>
              </g>
            ))}
            <line x1={CL} x2={CW - CR} y1={cy(39.3)} y2={cy(39.3)} class="cbase" />
            {CC.map((c) => (
              <g>
                <rect x={c.x} y={cy(c.v)} width={CBW} height={cy(0) - cy(c.v)} rx="4" class={`cbar ${c.cls}`} />
                <text x={c.x + CBW / 2} y={cy(c.v) - 6} class="cval" text-anchor="middle">{c.v.toFixed(1)}</text>
              </g>
            ))}
            {CG.map((g) => g.l.map((t, i) => (<text x={g.x} y={cy(0) + 18 + i * 15} class="clab" text-anchor="middle">{t}</text>)))}
            <line x1={CL} x2={CW - CR} y1={cy(0)} y2={cy(0)} class="axis" />
            <text transform={`translate(15 ${(CT + CH - CB) / 2}) rotate(-90)`} class="ax-title" text-anchor="middle">Downstream accuracy (%)</text>
          </svg>
        </div>
        <div class="item">
          <h4 class="it"><span class="it-n">B.4</span>Gains appear only on tasks that involve visual transitions</h4>
          <svg viewBox="0 0 520 170" role="img" aria-label="All 22 benchmarks with visual transitions improve; none of the 4 static-perception or general video QA benchmarks gains more than 2 points">
            <rect x="20" y="10" width="220" height="150" rx="12" class="sp-yes" />
            <text x="130" y="36" class="sp-h yes">Tasks with</text>
            <text x="130" y="53" class="sp-h yes">visual transitions</text>
            <text x="130" y="104" class="sp-big yes">22 / 22</text>
            <text x="130" y="134" class="sp-s">improve</text>
            <rect x="280" y="10" width="220" height="150" rx="12" class="sp-no" />
            <text x="390" y="36" class="sp-h">Static perception,</text>
            <text x="390" y="53" class="sp-h">general video QA</text>
            <text x="390" y="104" class="sp-big">0 / 4</text>
            <text x="390" y="134" class="sp-s">gain more than 2 points</text>
          </svg>
        </div>
      </div>
    </section>

    <section class="ev plus">
      <div class="ev-head"><span class="ev-n">+</span><h3 class="ev-t">Further test of causality by intervention</h3></div>
      <div class="items">
        <div class="item">
          <h4 class="it">Transition supervision can replace part of task-specific training data</h4>
          <figure class="ev-fig wide">
            <a href="figures/substitution.png" target="_blank" rel="noopener" class="zoom-link" title="Open full-size image"><img src="figures/substitution.png" alt="Three panels plotting accuracy against the share of task-specific training data replaced by WOVEN items under a fixed 2,000-item budget. Accuracy stays near the original level up to 30 to 50 percent replacement and stays above simply deleting those items." width="2000" height="573" loading="lazy" /></a>
          </figure>
        </div>
      </div>
    </section>
  </div>
</details>

