---
// Primitive.astro: RQ3 — a primitive, or a collection of task-specific effects?
import { DOSE, subsetName } from '../data/woven';

// Schematic: two explanations of the gains (left: task-specific effects; right: a shared primitive).
const SRC = ['Camera motion', 'Manipulation', 'Passive physics'];
const DST = ['Spatial', 'Embodied', 'Physical'];
const BW = 132, BH = 44, YS = [48, 112, 176];
const PW = 112, PH = 92, PX = 164, PY = 102;

// Dose-response scatter: WOVEN gain after SFT against the mean external gain, one dot per subset.
const SW = 520, SH = 300, SL = 62, SR = 16, ST = 14, SB = 50;
const XMAX = 26, YMAX = 3.5;
const sx = (x: number) => SL + (x / XMAX) * (SW - SL - SR);
const sy = (y: number) => SH - SB - (y / YMAX) * (SH - SB - ST);
const xs = DOSE.map((d) => d.w), ys = DOSE.map((d) => d.e);
const mean = (a: number[]) => a.reduce((s, v) => s + v, 0) / a.length;
const mx = mean(xs), my = mean(ys);
const sxy = xs.reduce((s, x, i) => s + (x - mx) * (ys[i] - my), 0);
const sxx = xs.reduce((s, x) => s + (x - mx) ** 2, 0);
const syy = ys.reduce((s, y) => s + (y - my) ** 2, 0);
const slope = sxy / sxx, icpt = my - slope * mx;
const r = sxy / Math.sqrt(sxx * syy);
const FX0 = 4, FX1 = 25.5;
// Consistency of answers to questions from one transition (paper appendix: 19.0 before, 94.3 after training on the full set).
const cyc = (v: number) => 168 - (v / 100) * 140;

// One row of data cells for the spread schematic: the trained cell, then data from other sources.
const CN = 7, CS = 30, CP = 40, CX0 = 244;

// Evidence schematics.
// Downstream benchmarks of the content control (paper appendix): domain tags, then benchmark names.
const DSB = [
  { n: 'Spatial', x: 40, w: 72, dom: true },
  { n: 'Embodied', x: 122, w: 86, dom: true },
  { n: 'SAT', x: 228, w: 54 },
  { n: 'SPAR-Bench', x: 292, w: 104 },
  { n: 'ActionEQA', x: 406, w: 98 },
  { n: 'WorldPrediction', x: 514, w: 132 },
];
---

<details class="rq" id="primitive" open>
  <summary>
    <span class="rq-tag">RQ3</span>
    <span class="rq-q">Is visual world modeling a primitive, or just a collection of task-specific effects?</span>
    <span class="rq-a">A primitive — different sources of supervision build the same capability, and broad downstream gains result from it.</span>
    <div class="schema">
      <figure class="schema-panel">
        <svg viewBox="0 0 440 236" role="img" aria-label="Task-specific effects: each supervision source improves only its own domain">
          <defs><marker id="ah-gray" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#a3acbb" /></marker></defs>
          <text x="86" y="26" class="col-h" text-anchor="middle">Supervision sources</text>
          <text x="354" y="26" class="col-h" text-anchor="middle">Downstream domains</text>
          {YS.map((y, k) => (
            <g>
              <rect x="20" y={y} width={BW} height={BH} rx="9" class="box src" />
              <text x={20 + BW / 2} y={y + 16} class="box-w">WOVEN</text>
              <text x={20 + BW / 2} y={y + 34} class="box-t">{SRC[k]}</text>
              <rect x={440 - 20 - BW} y={y} width={BW} height={BH} rx="9" class="box dst" />
              <text x={440 - 20 - BW / 2} y={y + BH / 2 + 5} class="box-t">{DST[k]}</text>
              <line x1={20 + BW + 8} y1={y + BH / 2} x2={440 - 20 - BW - 10} y2={y + BH / 2} class="arrow gray" marker-end="url(#ah-gray)" />
            </g>
          ))}
        </svg>
        <figcaption class="verdict no"><span class="mark">✕</span>A collection of task-specific effects</figcaption>
      </figure>
      <figure class="schema-panel">
        <svg viewBox="0 0 440 236" role="img" aria-label="A shared primitive: every supervision source builds visual world modeling, which helps every domain">
          <defs><marker id="ah-blue" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#2453c4" /></marker></defs>
          <text x="6" y="26" class="col-h" text-anchor="start">Supervision sources</text>
          <text x="434" y="26" class="col-h" text-anchor="end">Downstream domains</text>
          {YS.map((y, k) => (
            <g>
              <rect x="6" y={y} width={120} height={BH} rx="9" class="box src" />
              <text x={66} y={y + 16} class="box-w">WOVEN</text>
              <text x={66} y={y + 34} class="box-t">{SRC[k]}</text>
              <rect x={314} y={y} width={120} height={BH} rx="9" class="box dst" />
              <text x={374} y={y + BH / 2 + 5} class="box-t">{DST[k]}</text>
              <line x1={130} y1={y + BH / 2} x2={PX - 6} y2={PY + PH / 2 + (k - 1) * 22} class="arrow blue" marker-end="url(#ah-blue)" />
              <line x1={PX + PW + 4} y1={PY + PH / 2 + (k - 1) * 22} x2={308} y2={y + BH / 2} class="arrow blue" marker-end="url(#ah-blue)" />
            </g>
          ))}
          <rect x={PX} y={PY} width={PW} height={PH} rx="14" class="prim" />
          <text x={PX + PW / 2} y={PY + 32} class="prim-t">Visual</text>
          <text x={PX + PW / 2} y={PY + 51} class="prim-t">world</text>
          <text x={PX + PW / 2} y={PY + 70} class="prim-t">modeling</text>
        </svg>
        <figcaption class="verdict yes"><span class="mark">✓</span>A shared primitive</figcaption>
      </figure>
    </div>
  </summary>
  <div class="rq-body">
    <section class="ev">
      <div class="ev-head"><span class="ev-n">A</span><h3 class="ev-t">Different sources improve the same capability? <span class="yes">— Yes</span></h3></div>
      <div class="items">
        <div class="item">
          <h4 class="it"><span class="it-n">A.1</span>Each source improves far beyond the slice it trains on<span class="ok"> ✓</span><span class="inst">, instead of only that slice</span></h4>
          <svg viewBox="0 0 640 156" role="img" aria-label="If each source learned only its own slice, only the trained data would improve; instead, data from other sources improve too">
            <text x={CX0 + CS / 2} y="20" class="g-ax">Trained</text>
            <text x={CX0 + CP + (CN - 1) * CP / 2 - (CP - CS) / 2} y="20" class="g-ax">Other sources of data</text>
            <line x1={CX0 + CP} x2={CX0 + CN * CP - (CP - CS)} y1="30" y2="30" class="s-brace" />
            {[{ y: 44, lit: false }, { y: 112, lit: true }].map((r) => (
              <g>
                {r.lit
                  ? <text x="226" y={r.y + 20} class="s-lab ta-e">What we observe</text>
                  : <g><text x="226" y={r.y + 11} class="s-lab ta-e">If each source learned</text><text x="226" y={r.y + 28} class="s-lab ta-e">only its own slice</text></g>}
                {Array.from({ length: CN }, (_, k) => (
                  <rect x={CX0 + k * CP} y={r.y} width={CS} height={CS} rx="6" class={k === 0 ? 'g-cell on' : r.lit ? 'g-cell lit' : 'g-cell'} />
                ))}
                <text x={CX0 + CN * CP + 8} y={r.y + 20} class={r.lit ? 's-res ta-s' : 's-no ta-s'}>{r.lit ? '✓ improved too' : '✕ ruled out'}</text>
              </g>
            ))}
          </svg>
        </div>
        <div class="item">
          <h4 class="it"><span class="it-n">A.2</span>The model learns the transition itself<span class="ok"> ✓</span><span class="inst">, instead of separate skills for each question</span></h4>
          <svg class="cy" viewBox="0 0 280 200" role="img" aria-label="Consistency of answers to different questions from the same transition: 19 percent before training, 94 percent after training">
            {[0, 50, 100].map((t) => (<g><line x1="40" x2="270" y1={cyc(t)} y2={cyc(t)} class="grid" /><text x="32" y={cyc(t) + 4} class="tick" text-anchor="end">{t}%</text></g>))}
            <rect x="72" y={cyc(19.0)} width="64" height={cyc(0) - cyc(19.0)} rx="5" class="cy-before" />
            <text x="104" y={cyc(19.0) - 8} class="cy-val">19%</text>
            <rect x="174" y={cyc(94.3)} width="64" height={cyc(0) - cyc(94.3)} rx="5" class="cy-after" />
            <text x="206" y={cyc(94.3) - 8} class="cy-val blue">94%</text>
            <line x1="40" x2="270" y1={cyc(0)} y2={cyc(0)} class="axis" />
            <text x="104" y="192" class="cy-lab">Before training</text>
            <text x="206" y="192" class="cy-lab">After training</text>
          </svg>
          <p class="it-cap">Consistency of different questions from the same transition</p>
        </div>
        <div class="item">
          <h4 class="it"><span class="it-n">A.3</span>The gains come from real visual world modeling<span class="ok"> ✓</span><span class="inst">, instead of a shortcut</span></h4>
          <p class="it-more">See details in <a href="https://arxiv.org/abs/2610.12417" target="_blank" rel="noopener">our paper</a>.</p>
        </div>
      </div>
    </section>

    <section class="ev">
      <div class="ev-head"><span class="ev-n">B</span><h3 class="ev-t">The downstream gains result from that capability? <span class="yes">— Yes</span></h3></div>
      <div class="items">
        <div class="item">
          <h4 class="it"><span class="it-n">B.1</span>The model learns a similar profile from different sources of supervision<span class="ok"> ✓</span><span class="inst">, instead of a different profile for each source</span></h4>
          <div class="cmat">
            <img src="figures/profiles_raw.png" alt="Correlation matrix of the 11 subsets' transfer profiles; every cell is positive." width="506" height="506" loading="lazy" />
            <div class="cmat-side">
              <p class="cmat-big">55 / 55</p>
              <p class="cmat-txt">pairs positive</p>
              <div class="cmat-key"><span>0</span><span class="cmat-bar"></span><span>1</span></div>
            </div>
          </div>
          <p class="it-cap">All pairs of sources have positively correlated transfer: they improve largely the same downstream benchmarks.</p>
        </div>
        <div class="item">
          <h4 class="it"><span class="it-n">B.2</span>Downstream gains grow with the capability learned<span class="ok"> ✓</span><span class="inst">, instead of being unrelated to it</span></h4>
          <svg viewBox={`0 0 ${SW} ${SH}`} role="img" aria-label={`Mean downstream gain against WOVEN gain for the 11 subsets; r = ${r.toFixed(2)}`}>
            {[0, 1, 2, 3].map((t) => (
              <g>
                <line x1={SL} x2={SW - SR} y1={sy(t)} y2={sy(t)} class="grid" />
                <text x={SL - 8} y={sy(t) + 4} class="tick" text-anchor="end">{t}</text>
              </g>
            ))}
            {[0, 5, 10, 15, 20, 25].map((t) => (<text x={sx(t)} y={SH - SB + 18} class="tick" text-anchor="middle">{t}</text>))}
            <line x1={SL} x2={SW - SR} y1={sy(0)} y2={sy(0)} class="axis" />
            <line x1={sx(FX0)} y1={sy(icpt + slope * FX0)} x2={sx(FX1)} y2={sy(icpt + slope * FX1)} class="fit" />
            {DOSE.map((d) => (<circle cx={sx(d.w)} cy={sy(d.e)} r="6.5" class="pt" />))}
            <text x={sx(1)} y={sy(3.15)} class="r-lab">r = {r.toFixed(2)}</text>
            <text x={(SL + SW - SR) / 2} y={SH - 8} class="ax-title" text-anchor="middle">Gain on WOVEN (points)</text>
            <text transform={`translate(16 ${(ST + SH - SB) / 2}) rotate(-90)`} class="ax-title" text-anchor="middle">Mean downstream gain (points)</text>
          </svg>
          <p class="it-cap">Sources that improve WOVEN accuracy more also transfer more (r = 0.86 across the 11 sources).</p>
        </div>
        <div class="item">
          <h4 class="it"><span class="it-n">B.3</span>Transfer requires learning how the world really changes<span class="ok"> ✓</span><span class="inst">, instead of the question format or any learnable rule</span></h4>
          <svg class="worlds" viewBox="0 0 720 334" role="img" aria-label="Training on the WOVEN world transfers to downstream benchmarks; a perturbed WOVEN world with stable, predictable, but wrong rules is learned on its own test set but does not transfer; other multiple-choice data does not transfer">
            <defs><marker id="m5" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#8a94a6" /></marker></defs>
            <rect x="22" y="8" width="216" height="78" rx="12" class="w-real" />
            <text x="130" y="40" class="w-t">WOVEN world</text>
            <text x="130" y="62" class="w-s">correct transitions</text>
            <rect x="252" y="8" width="216" height="78" rx="12" class="w-pert" />
            <text x="360" y="34" class="w-t">Perturbed WOVEN world</text>
            <text x="360" y="54" class="w-s">stable, predictable, but wrong rules</text>
            <text x="360" y="71" class="w-s">same question format</text>
            <rect x="482" y="8" width="216" height="78" rx="12" class="w-other" />
            <text x="590" y="40" class="w-t">Other multiple-choice data</text>
            <text x="590" y="62" class="w-s">no transitions</text>
            {[{ cx: 130, label: 'WOVEN test' }, { cx: 360, label: 'Perturbed WOVEN test' }].map((t) => (
              <g>
                <line x1={t.cx - 40} y1="88" x2={t.cx - 40} y2="146" class="w-arr" marker-end="url(#m5)" />
                <circle cx={t.cx - 40} cy="117" r="10" class="mk-ok" /><text x={t.cx - 40} y="121.5" class="mk-ok-t">✓</text>
                <rect x={t.cx - 118} y="150" width="156" height="32" rx="8" class="w-test" />
                <text x={t.cx - 40} y="171" class="w-tt">{t.label}</text>
              </g>
            ))}
            <text x="320" y="200" class="w-note">learns the wrong rules</text>
            {[{ x: 190, ok: true }, { x: 420, ok: false }, { x: 590, ok: false }].map((d) => (
              <g>
                <line x1={d.x} y1="88" x2={d.x} y2="244" class="w-arr" marker-end="url(#m5)" />
                <circle cx={d.x} cy="214" r="10" class={d.ok ? 'mk-ok' : 'mk-no'} />
                <text x={d.x} y="218.5" class={d.ok ? 'mk-ok-t' : 'mk-no-t'}>{d.ok ? '✓' : '✕'}</text>
                {!d.ok && <text x={d.x + 16} y="218" class="w-no">no transfer</text>}
              </g>
            ))}
            <rect x="20" y="248" width="680" height="78" rx="14" class="w-down" />
            <text x="40" y="272" class="w-dt">Downstream benchmarks</text>
            {DSB.map((b) => (<g><rect x={b.x} y="284" width={b.w} height="26" rx="13" class={b.dom ? 'w-chip dom' : 'w-chip'} /><text x={b.x + b.w / 2} y="301.5" class={b.dom ? 'w-ct dom' : 'w-ct'}>{b.n}</text></g>))}
            <text x="672" y="302" class="w-more">…</text>
          </svg>
          <p class="it-cap">With the same question format and amount of training, the wrong rules of the perturbed world are learned on its own test set, yet only the correct transitions improve downstream benchmarks.</p>
        </div>
        <div class="item">
          <h4 class="it"><span class="it-n">B.4</span>The capability helps exactly the tasks that need it<span class="ok"> ✓</span><span class="inst">, instead of making the model generally stronger</span></h4>
          <svg viewBox="0 0 520 170" role="img" aria-label="All 22 benchmarks with visual transitions improve; none of the 4 static-perception or general video QA benchmarks gains more than 2 points">
            <rect x="20" y="10" width="220" height="150" rx="12" class="sp-yes" />
            <text x="130" y="36" class="sp-h yes">Tasks with</text>
            <text x="130" y="53" class="sp-h yes">visual transitions</text>
            <text x="130" y="104" class="sp-big yes">22 / 22</text>
            <text x="130" y="134" class="sp-s">improve</text>
            <rect x="280" y="10" width="220" height="150" rx="12" class="sp-no" />
            <text x="390" y="36" class="sp-h">Static perception,</text>
            <text x="390" y="53" class="sp-h">general video QA</text>
            <text x="390" y="104" class="sp-big">0 / 4</text>
            <text x="390" y="134" class="sp-s">gain more than 2 points</text>
          </svg>
          <p class="it-cap">All 22 benchmarks with visual transitions improve; none of the 4 without them gains more than 2 points.</p>
        </div>
      </div>
    </section>

    <section class="ev plus">
      <div class="ev-head"><span class="ev-n">+</span><h3 class="ev-t">Further test of causality by intervention</h3></div>
      <div class="items">
        <div class="item">
          <h4 class="it">Transition supervision can replace part of task-specific training data<span class="ok"> ✓</span><span class="inst">, instead of acting like deleted data</span></h4>
          <figure class="ev-fig wide">
            <a href="figures/substitution.png" target="_blank" rel="noopener" class="zoom-link" title="Open full-size image"><img src="figures/substitution.png" alt="Three panels plotting accuracy against the share of task-specific training data replaced by WOVEN items under a fixed 2,000-item budget. Accuracy stays near the original level up to 30 to 50 percent replacement and stays above simply deleting those items." width="2000" height="573" loading="lazy" /></a>
          </figure>
        </div>
      </div>
    </section>
  </div>
</details>

