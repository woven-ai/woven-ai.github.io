---
// Transfer.astro: RQ2 — learnability and transfer, shown as one radar chart per domain.
import { DOMAINS } from '../data/woven';

const W = 440, H = 360, CX = 220, CY = 184, R = 122;
// Radius encodes the gain over the base model: the base model is the inner ring (R0), and the
// distance beyond it grows with the square root of the gain, on one scale shared by all four charts.
const R0 = 0.4 * R;
const DMAX = Math.max(...DOMAINS.flatMap((d) => d.items.map((it) => it.d)));
const gr = (g: number) => R0 + (R - R0) * Math.sqrt(Math.max(g, 0) / DMAX);
const ang = (i: number, n: number) => -Math.PI / 2 + (2 * Math.PI * i) / n;
const at = (r: number, i: number, n: number) => { const a = ang(i, n); return [CX + r * Math.cos(a), CY + r * Math.sin(a)]; };
const poly = (rs: number[]) => rs.map((r, i) => at(r, i, rs.length).map((x) => x.toFixed(1)).join(',')).join(' ');
const ringGains = [5, 10, 20];
// Interleave large and small gains around the circle so the shape reads as a whole.
const interleave = <T,>(xs: T[]) => { const out: T[] = []; let lo = 0, hi = xs.length - 1; while (lo <= hi) { out.push(xs[lo++]); if (lo <= hi) out.push(xs[hi--]); } return out; };
const label = (i: number, n: number) => {
  const a = ang(i, n), r = R + 16;
  const x = CX + r * Math.cos(a), y = CY + r * Math.sin(a);
  const c = Math.cos(a), s = Math.sin(a);
  const anchor = c > 0.3 ? 'start' : c < -0.3 ? 'end' : 'middle';
  const dy = s < -0.6 ? -18 : s > 0.6 ? 6 : -6;
  return { x, y: y + dy, anchor };
};
const charts = DOMAINS.map((d) => {
  const items = interleave([...d.items].sort((a, b) => b.d - a.d));
  const n = items.length;
  return {
    name: d.name,
    n,
    maxGain: Math.max(...items.map((it) => it.d)),
    base: poly(Array(n).fill(R0)),
    best: poly(items.map((it) => gr(it.d))),
    ringPolys: ringGains.map((g) => ({ g, p: poly(Array(n).fill(gr(g))) })),
    outer: poly(Array(n).fill(R)),
    spokes: items.map((_, i) => at(R, i, n)),
    dots: items.map((it, i) => at(gr(it.d), i, n)),
    labels: items.map((it, i) => ({ ...label(i, n), b: it.b, d: it.d, base: it.base, best: it.best })),
    ringLabel: (g: number) => { const a = -Math.PI / 2 - Math.PI / n, r = gr(g); return [CX + r * Math.cos(a), CY + r * Math.sin(a)]; },
  };
});
---
<details class="rq" id="transfer">
  <summary>
    <span class="rq-tag">RQ2</span>
    <span class="rq-q">Can visual world modeling be learned, and does it transfer?</span>
    <span class="rq-a">Yes — subsets of about 2,000 items each improve 22 of 26 external benchmarks, spanning spatial, embodied, physical, and temporal reasoning.</span>
  </summary>
  <div class="rq-body">
    <div class="radar-grid">
      {charts.map((c) => (
        <figure class="radar">
          <figcaption class="radar-head"><span class="dname">{c.name}</span><span class="dmeta">{c.n} benchmarks · up to +{c.maxGain.toFixed(1)}</span></figcaption>
          <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${c.name}: accuracy before and after training on ${c.n} benchmarks`}>
            <polygon points={c.outer} class="ring outer" />
            {c.spokes.map(([x, y]) => (<line x1={CX} y1={CY} x2={x} y2={y} class="spoke" />))}
            <polygon points={c.best} class="best" />
            <polygon points={c.base} class="base" />
            {c.dots.map(([x, y]) => (<circle cx={x} cy={y} r="3.2" class="dot" />))}
            {c.labels.map((l) => (
              <text x={l.x} y={l.y} text-anchor={l.anchor} class="ax-lab">
                <title>{`${l.b}: ${l.base.toFixed(1)} → ${l.best.toFixed(1)}`}</title>
                <tspan x={l.x} class="ax-name">{l.b}</tspan>
                <tspan x={l.x} dy="15" class="ax-gain">+{l.d.toFixed(1)}</tspan>
              </text>
            ))}
          </svg>
        </figure>
      ))}
    </div>
    <p class="rq-note">
      Each axis is one external benchmark. <span class="key key-base"></span>Gray: Qwen2.5-VL-3B-Instruct. <span class="key key-best"></span>Blue: gain after training on the best controlled subset for that benchmark (larger of SFT and GRPO), in percentage points on a square-root scale; hover a label for the accuracies.
      The four benchmarks of static perception and general video QA do not improve.
    </p>
  </div>
</details>

<style>
  .radar-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 1.4rem; }
  .radar { margin: 0; }
  .radar-head { display: flex; align-items: baseline; justify-content: center; gap: 0.6rem; margin-bottom: 0.2rem; }
  .dname { font-size: 1.05rem; font-weight: 700; color: #14213a; }
  .dmeta { font-size: 0.85rem; color: #556; }
  .radar svg { width: 100%; height: auto; overflow: visible; display: block; }
  .ring { fill: none; stroke: #e3e8f1; stroke-width: 1; stroke-dasharray: 3 3; }
  .ring.outer { stroke-dasharray: none; }
  .spoke { stroke: #e3e8f1; stroke-width: 1; }
  .best { fill: rgba(36, 83, 196, 0.85); stroke: #2453c4; stroke-width: 2; stroke-linejoin: round; }
  .base { fill: #e9edf4; stroke: #8a94a6; stroke-width: 1.5; stroke-linejoin: round; }
  .dot { fill: #2453c4; stroke: #fff; stroke-width: 1.2; }
  .ring-lab { font-size: 10px; fill: #7d8798; paint-order: stroke; stroke: #fff; stroke-width: 3px; stroke-linejoin: round; }
  .ax-lab { font-size: 13px; }
  .ax-name { fill: #1c2a3a; font-weight: 500; }
  .ax-gain { fill: #2453c4; font-weight: 700; }
  .key { display: inline-block; width: 12px; height: 12px; border-radius: 3px; vertical-align: -1px; margin: 0 0.25rem 0 0.6rem; }
  .key-base { background: #eef1f6; border: 1.5px solid #8a94a6; }
  .key-best { background: rgba(36, 83, 196, 0.85); }
  @media (max-width: 760px) { .radar-grid { grid-template-columns: 1fr; } }
</style>
