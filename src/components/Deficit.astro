---
// Deficit.astro: RQ1 — do current MLLMs show a deficit?
import { DEFICIT_COLS, DEFICIT_ROWS } from '../data/woven';
const groups = [
  { label: '', span: 2 },
  { label: 'Action type', span: 5 },
  { label: 'Reasoning type', span: 8 },
  { label: 'Perturbation', span: 2 },
];
const colTitles: Record<string, string> = {
  Exo: 'Passive physical events', Perc: 'Camera motion', Insp: 'Object inspection', Navi: 'Navigation', Mani: 'Object manipulation',
  Fwd: 'Forward dynamics', Inv: 'Inverse dynamics', Rmv: 'Counterfactual removal', Sub: 'Counterfactual substitution',
  Otm: 'Outcome prediction', Cue: 'Cued prediction', Ord: 'Temporal ordering', Adj: 'Temporal adjacency',
  Geo: 'Geometric perturbation', App: 'Appearance perturbation',
};
const human = DEFICIT_ROWS.find((r) => r.model === 'Human');
const models = DEFICIT_ROWS.filter((r) => r.model !== 'Human');
const tableRows = [...models, ...(human ? [human] : [])];
---
<details class="rq" id="deficit">
  <summary>
    <span class="rq-tag">RQ1</span>
    <span class="rq-q">Do current MLLMs show a deficit?</span>
    <span class="rq-a">Yes — the strongest of 38 frontier MLLMs reaches 65.8%, and the failures recur across model families and scales.</span>
  </summary>
  <div class="rq-body">
    <div class="acc-bars" role="list" aria-label="In-distribution accuracy of the four strongest models">
      {models.map((r) => (
        <div class="arow" role="listitem">
          <span class="aname">{r.model}</span>
          <span class="atrack"><span class="abar" style={`width:${r.v[0]}%`}></span><span class="aval" style={`left:calc(${r.v[0]}% + 6px)`}>{r.v[0].toFixed(1)}</span></span>
        </div>
      ))}
    </div>
    <p class="rq-note">In-distribution accuracy (%) of the four strongest models; chance is 25%, human annotators reach {human?.v[0].toFixed(1)}%. Results for all 38 models are in the paper.</p>

    <details class="more">
      <summary>Accuracy by action type, reasoning type, and state perturbation</summary>
      <div class="table-scroll" role="region" aria-label="Accuracy by category" tabindex="0">
        <table class="data-table">
          <thead>
            <tr>{groups.map((g) => <th colspan={g.span} class="group">{g.label}</th>)}</tr>
            <tr><th class="rowhead">Accuracy (%)</th>{DEFICIT_COLS.map((c) => <th title={colTitles[c] ?? c}>{c}</th>)}</tr>
          </thead>
          <tbody>
            {tableRows.map((r) => (
              <tr class={r.model === 'Human' ? 'human' : ''}>
                <th class="rowhead">{r.model}</th>
                {r.v.map((x) => <td>{x.toFixed(1)}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="rq-note">Hover a column header for its full name.</p>
    </details>
  </div>
</details>

<style>
  .acc-bars { display: flex; flex-direction: column; gap: 8px; max-width: 760px; }
  .arow { display: grid; grid-template-columns: 150px minmax(0, 1fr); align-items: center; gap: 0.8rem; }
  .aname { text-align: right; font-size: 0.92rem; color: #222; }
  .atrack { position: relative; height: 24px; background: #f2f4f8; border-radius: 4px; }
  .abar { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 4px; background: var(--accent-color); }
  .aval { position: absolute; top: 3px; font-size: 0.85rem; font-weight: 600; color: #333; font-variant-numeric: tabular-nums; }
  @media (max-width: 520px) { .arow { grid-template-columns: 110px minmax(0, 1fr); } }
</style>
