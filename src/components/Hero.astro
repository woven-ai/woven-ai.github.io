---
// Hero.astro: title block, key takeaway, resources, authors, teaser, and the four research questions.
const authorLines = [
  [
    { name: 'Zheyu Fan', aff: '1', url: 'https://lorduky.github.io/' },
    { name: 'Yue Zhang', aff: '3', url: 'https://zhangyuejoslin.github.io/' },
    { name: 'Mingkai Deng', aff: '2', url: 'https://mingkaid.github.io/' },
    { name: 'Kangrui Wang', aff: '1', url: 'https://jameskrw.github.io/' },
    { name: 'Qineng Wang', aff: '1', url: 'https://qinengwang-aiden.github.io/' },
    { name: 'Canyu Chen', aff: '1', url: 'https://canyuchen.com/' },
  ],
  [
    { name: 'Jie Hao', aff: '4', url: 'https://scholar.google.com/citations?user=5MLHAiUAAAAJ' },
    { name: 'Xing Fan', aff: '4', url: 'https://scholar.google.com/citations?user=W_NygtQAAAAJ' },
    { name: 'Chenlei Guo', aff: '4', url: 'https://scholar.google.com/citations?user=gRFsEm4AAAAJ' },
    { name: 'Eric P. Xing', aff: '2', url: 'https://www.cs.cmu.edu/~epxing/' },
    { name: 'Mohit Bansal', aff: '3', url: 'https://www.cs.unc.edu/~mbansal/' },
    { name: 'Manling Li', aff: '1', url: 'https://limanling.github.io/' },
  ],
];
const affiliations = ['Northwestern University', 'Carnegie Mellon University', 'UNC Chapel Hill', 'Amazon'];

const questions = [
  { id: 'deficit', tag: 'Question 1', title: 'Is there a systematic deficit?', stat: '38', unit: 'frontier MLLMs evaluated', text: 'The strongest reaches 65.8% in distribution; humans reach 92.3%. The failures recur across model families.' },
  { id: 'transfer', tag: 'Question 2', title: 'Is it learnable and transferable?', stat: '22 / 26', unit: 'external benchmarks improved', text: 'Controlled subsets of about 2,000 items each, with gains of up to 27.3 percentage points.' },
  { id: 'primitive', tag: 'Question 3', title: 'Is it a shared primitive?', stat: 'r = 0.86', unit: 'capability gain vs. transfer', text: 'WOVEN data can replace 30–50% of a task’s own training data with comparable accuracy.' },
  { id: 'recipe', tag: 'Question 4', title: 'Is there a training recipe?', stat: '5 / 5', unit: 'prospective comparisons as predicted', text: 'Select supervision by the reasoning operation it teaches; larger state changes give robustness.' },
];
---
<section id="hero" class="content-section hero-section">
  <h1 class="wordmark">
    <img src="logo/woven_logo.png" alt="WOVEN" width="900" height="256" />
  </h1>
  <p class="subtitle">Weaving Visual World Modeling into Multimodal LLMs</p>

  <p class="research-question">Can visual transition reasoning serve as a shared training primitive for multimodal LLMs?</p>

  <div class="authors-section">
    {authorLines.map((line, li) => (
      <p class="authors-line">
        {line.map((a, i) => (
          <span class="author"><a href={a.url} target="_blank" rel="noopener noreferrer">{a.name}</a><sup>{a.aff}</sup>{i < line.length - 1 || li < authorLines.length - 1 ? ',' : ''}</span>
        ))}
      </p>
    ))}
    <p class="affiliations-line">
      {affiliations.map((a, i) => (<span class="affiliation"><sup>{i + 1}</sup>{a}</span>))}
    </p>
  </div>

  <div class="takeaway">
    <span class="takeaway-label">Key Takeaway</span>
    <p>Training subsets of only about 2,000 WOVEN items each collectively improve <strong>22 of 26</strong> external benchmarks, by up to <strong>27.3 percentage points</strong>. The gains come from one shared capability, and controlled comparisons yield a <strong>training recipe</strong> for visual world modeling, validated prospectively on held-out benchmarks.</p>
  </div>

  <div class="resources-section">
    <div class="resources-buttons">
      <a href="https://arxiv.org/abs/2610.12417" class="resource-button" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="resource-icon" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
        <span>Paper</span>
      </a>
      <a href="https://github.com/mll-lab-nu/WOVEN" class="resource-button" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="resource-icon" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        <span>Code</span>
      </a>
      <a href="https://huggingface.co/datasets/MLL-Lab/WOVEN" class="resource-button" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="resource-icon" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
        <span>Dataset</span>
      </a>
      <a href="#citation" class="resource-button">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="resource-icon" aria-hidden="true"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path></svg>
        <span>BibTeX</span>
      </a>
    </div>
  </div>

  <figure class="teaser">
    <a href="figures/teaser.jpg" target="_blank" rel="noopener" class="zoom-link" title="Open full-size image"><img src="figures/teaser.jpg" alt="Overview figure. Panel 1: MLLMs fail on spatial, embodied, physical and temporal tasks. Panel 2: these failures share reasoning about how visual states, actions and outcomes relate. Panel 3: WOVEN generates (s, a, s′) transitions with a video generation model and turns them into error-typed multiple-choice supervision. Panel 4: training on WOVEN improves 22 of 26 external benchmarks and yields a training recipe." width="2000" height="1125" fetchpriority="high" /></a>
    <figcaption><strong>Overview.</strong> (1) MLLMs fail across spatial, embodied, physical, and temporal tasks. (2) These failures share a weakness: reasoning about how visual states, actions, and outcomes relate. (3) WOVEN generates (s, a, s′) transitions with a video generation model, organizes them along controlled axes of reasoning, action, and scene, and turns them into error-typed multiple-choice supervision. (4) Training on WOVEN improves 22 of 26 external benchmarks; the gains come from a shared primitive that different sources build and different tasks use; and controlled comparisons yield a training recipe.</figcaption>
  </figure>

  <div class="question-cards">
    {questions.map((q) => (
      <a href={`#${q.id}`} class="question-card">
        <span class="q-tag">{q.tag}</span>
        <span class="q-title">{q.title}</span>
        <span class="q-stat">{q.stat}</span>
        <span class="q-unit">{q.unit}</span>
        <span class="q-text">{q.text}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .wordmark { margin: 0.5rem auto 0; line-height: 0; }
  .wordmark img { width: min(520px, 82vw); height: auto; }
  .subtitle { font-size: clamp(1.15rem, 2.4vw, 1.6rem); font-weight: 600; color: #1c2a3a; margin: 1rem auto 0; max-width: 820px; }
  .research-question { margin: 1.4rem auto 0; max-width: 760px; font-size: clamp(1.02rem, 1.8vw, 1.2rem); color: #334; font-style: italic; }
  .takeaway { margin: 1.4rem auto 0; max-width: 860px; text-align: left; background: #fff; border: 1px solid rgba(36, 83, 196, 0.25); border-left: 5px solid var(--accent-color); border-radius: 12px; padding: 1rem 1.25rem; box-shadow: 0 4px 16px rgba(36, 83, 196, 0.08); }
  .takeaway-label { display: inline-block; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-color); margin-bottom: 0.35rem; }
  .takeaway p { font-size: 1.04rem; line-height: 1.65; color: #222; }
  .resource-button.is-soon { opacity: 0.55; cursor: default; }
  .resource-button.is-soon:hover { transform: none; }
  .resource-button small { font-size: 0.7rem; font-weight: 600; margin-left: 0.15rem; color: #667; text-transform: uppercase; letter-spacing: 0.04em; }
  .authors-section { margin: 1.4rem auto 0; max-width: 1000px; }
  .authors-line { font-size: 1.02rem; line-height: 1.9; color: #222; display: flex; flex-wrap: wrap; justify-content: center; column-gap: 0.45em; }
  .author { white-space: nowrap; }
  .authors-line a { color: var(--accent-color); text-decoration: none; font-weight: 500; }
  .authors-line a:hover { text-decoration: underline; }
  .authors-line sup, .affiliations-line sup { font-size: 0.7em; margin-left: 1px; color: #556; }
  .affiliations-line { margin-top: 0.35rem; font-size: 0.95rem; color: #445; display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; justify-content: center; }
  .teaser { margin: 2.2rem auto 0; max-width: 1100px; }
  .teaser img { width: 100%; height: auto; border-radius: 12px; background: #fff; box-shadow: 0 4px 18px rgba(36, 83, 196, 0.12); }
  .teaser figcaption { margin: 0.8rem auto 0; max-width: 980px; text-align: left; font-size: 0.95rem; line-height: 1.6; color: #444; }
  .question-cards { margin: 2.2rem auto 0; max-width: 1100px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; text-align: left; }
  .question-card { display: flex; flex-direction: column; gap: 0.3rem; background: #fff; border: 1px solid var(--card-border); border-radius: 14px; padding: 1rem 1.1rem 1.1rem; text-decoration: none; color: inherit; box-shadow: 0 2px 10px rgba(36, 83, 196, 0.06); transition: transform 0.15s ease, box-shadow 0.15s ease; }
  .question-card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(36, 83, 196, 0.14); }
  .q-tag { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-color); }
  .q-title { font-size: 1rem; font-weight: 600; color: #1c2a3a; }
  .q-stat { font-size: 1.7rem; font-weight: 700; color: var(--accent-color); margin-top: 0.3rem; font-variant-numeric: tabular-nums; }
  .q-unit { font-size: 0.85rem; color: #556; margin-top: -0.2rem; }
  .q-text { font-size: 0.9rem; line-height: 1.5; color: #333; margin-top: 0.3rem; }
  @media (max-width: 900px) { .question-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .question-cards { grid-template-columns: 1fr; } }
</style>
