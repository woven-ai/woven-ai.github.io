---
// Recipe.astro: RQ4 — so what? How should we train it: a training recipe.
import { ROBUSTNESS, ACTION_NAMES, TRANSFER } from '../data/woven';
const fmt = (x: number, d = 1) => `${x > 0 ? '+' : x < 0 ? '−' : ''}${Math.abs(x).toFixed(d)}`;

// Shared chart frame (SVG units).
const CW = 520, CH = 250, PL = 62, PR = 12, PT = 18, PB = 58;
const plotW = CW - PL - PR, plotH = CH - PT - PB;
const yScale = (lo: number, hi: number) => (v: number) => PT + plotH * (1 - (v - lo) / (hi - lo));

// Rule 2: robustness gain by the extent of the state change (causal subsets, then passive physical events).
const y2 = yScale(0, 32);
const bw2 = plotW / ROBUSTNESS.length;
const bars2 = ROBUSTNESS.map((r, i) => {
  const words = ACTION_NAMES[r.s.split('_')[0]].split(' ');
  const mid = Math.ceil(words.length / 2);
  return { x: PL + i * bw2 + bw2 * 0.2, w: bw2 * 0.6, y: y2(r.d), h: y2(0) - y2(r.d), d: r.d, l1: words.slice(0, mid).join(' '), l2: words.slice(mid).join(' ') };
});

// Rule 4: gains on benchmarks with visual transitions vs static perception / general video QA,
// on a signed log scale: f(v) = sign(v) * log10(1 + |v|).
const slog = (v: number) => Math.sign(v) * Math.log10(1 + Math.abs(v));
const y4raw = yScale(slog(-1.5), slog(30));
const y4 = (v: number) => y4raw(slog(v));
const trans = TRANSFER.filter((r) => !r.static), stat = TRANSFER.filter((r) => r.static);
const midX = PL + plotW * 0.62;
const colX = [PL + (midX - PL) / 2, midX + (CW - PR - midX) / 2];
const jitter = (i: number) => ((i % 5) - 2) * 15 + (Math.floor(i / 5) % 2) * 7;
const dots4 = [
  ...trans.map((r, i) => ({ cx: colX[0] + jitter(i), cy: y4(r.d), b: r.b, d: r.d, st: false })),
  ...stat.map((r, i) => ({ cx: colX[1] + (i - 1.5) * 18, cy: y4(r.d), b: r.b, d: r.d, st: true })),
];
---

<details class="rq" id="recipe">
  <summary>
    <span class="rq-tag">RQ4</span>
    <span class="rq-q">So what? How should we train it — a training recipe</span>
    <span class="rq-a">Select supervision by the reasoning operation it teaches, and prefer large state changes;<br />All recipies prospectively validated on held-out tasks.</span>
  </summary>
  <div class="rq-body">
    <div class="rule">
      <div class="rule-text"><span class="rhead"><span class="rn">1</span><span class="rflag">How to prospectively choose the right data</span></span><span class="rt">Select supervision by reasoning operation</span><span class="rx">To improve a downstream task, select supervision that teaches the reasoning operation the task requires, not supervision that matches its actions, scenes, or domains.</span></div>
      <figure class="rule-fig">
        <a href="figures/grouping.png" target="_blank" rel="noopener" class="zoom-link" title="Open full-size image"><img src="figures/grouping.png" alt="Three correlation matrices of the 11 subsets' transfer profiles: raw profiles with all pairs positive; residual profiles ordered by action type with no block structure; residual profiles ordered by reasoning family with diagonal blocks." width="2400" height="673" loading="lazy" /></a>
        <figcaption>Correlation of the 11 subsets’ transfer profiles: after removing the shared component, blocks appear only when subsets are grouped by reasoning family (right), not by action, scene, domain, or visual similarity.</figcaption>
      </figure>
    </div>

    <div class="rule">
      <div class="rule-text"><span class="rhead"><span class="rn">2</span><span class="rflag">How to get larger robustness</span></span><span class="rt">Prefer large state changes for robustness</span><span class="rx">For robustness, prefer supervision with large state changes, such as object manipulation over camera motion.</span></div>
      <figure class="rule-fig">
        <svg viewBox={`0 0 ${CW} ${CH}`} class="chart-svg" role="img" aria-label="Gain on the state-perturbation test rises with the extent of the state change">
          {[0, 10, 20, 30].map((t) => (<g><line x1={PL} x2={CW - PR} y1={y2(t)} y2={y2(t)} class="grid" /><text x={PL - 8} y={y2(t) + 4} class="tick">{t}</text></g>))}
          {bars2.map((b) => (<g>
            <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="3" class="bar2" />
            <text x={b.x + b.w / 2} y={b.y - 6} class="val">+{b.d.toFixed(1)}</text>
            <text x={b.x + b.w / 2} y={PT + plotH + 16} class="xl">{b.l1}</text>
            <text x={b.x + b.w / 2} y={PT + plotH + 30} class="xl">{b.l2}</text>
          </g>))}
          <line x1={PL} x2={CW - PR - 6} y1={CH - 10} y2={CH - 10} class="axis-arrow" marker-end="url(#ax-ah)" />
          <defs><marker id="ax-ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#7d8798" /></marker></defs>
          <text x={PL + plotW / 2} y={CH - 14} class="axl">Extent of the state change</text>
                  <text transform={`translate(16 ${PT + plotH / 2}) rotate(-90)`} class="ytitle">Gain on state perturbation (points)</text>
        </svg>
      </figure>
    </div>

    <div class="rule">
      <div class="rule-text"><span class="rhead"><span class="rn">3</span><span class="rflag">What are the internal boundaries</span></span><span class="rt">Supervise temporal and agent-driven tasks directly</span><span class="rx">Transfer does not cross the boundary between the temporal family and the other three, nor the boundary between passive physical events and agent-driven actions.</span></div>
      <figure class="rule-fig">
        <svg viewBox="0 0 520 250" class="chart-svg" role="img" aria-label="Transfer does not cross two boundaries: temporal versus other reasoning families, and endogenous (agent-driven) versus exogenous (passive) actions">
          <text x="12" y="26" class="b-row">Reasoning families</text>
          <rect x="12" y="36" width="190" height="62" rx="12" class="bx tmp" />
          <text x="107" y="63" class="bx-t tmp">Temporal</text>
          <text x="107" y="83" class="bx-s">temporal coherence</text>
          <rect x="318" y="36" width="190" height="62" rx="12" class="bx oth" />
          <text x="413" y="63" class="bx-t">Others</text>
          <text x="413" y="83" class="bx-s">causal · counterfactual · physical</text>
          <line x1="210" y1="67" x2="310" y2="67" class="b-arrow" marker-start="url(#b-ah)" marker-end="url(#b-ah)" />
          <circle cx="260" cy="67" r="13" class="b-x" /><path d="M254,61 L266,73 M266,61 L254,73" class="b-xm" />

          <text x="12" y="146" class="b-row">Action types</text>
          <rect x="12" y="156" width="190" height="62" rx="12" class="bx endo" />
          <text x="107" y="183" class="bx-t endo">Endogenous</text>
          <text x="107" y="203" class="bx-s">agent-driven actions</text>
          <rect x="318" y="156" width="190" height="62" rx="12" class="bx exo" />
          <text x="413" y="183" class="bx-t exo">Exogenous</text>
          <text x="413" y="203" class="bx-s">passive physical events</text>
          <line x1="210" y1="187" x2="310" y2="187" class="b-arrow" marker-start="url(#b-ah)" marker-end="url(#b-ah)" />
          <circle cx="260" cy="187" r="13" class="b-x" /><path d="M254,181 L266,193 M266,181 L254,193" class="b-xm" />
          <defs><marker id="b-ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#a3acbb" /></marker></defs>
        </svg>
      </figure>
    </div>

    <div class="rule">
      <div class="rule-text"><span class="rhead"><span class="rn">4</span><span class="rflag">Where should we stop</span></span><span class="rt">Transition supervision helps transition tasks</span><span class="rx">For downstream tasks that involve no transition, such as static perception, transition supervision does not help.</span></div>
      <figure class="rule-fig">
        <svg viewBox={`0 0 ${CW} ${CH}`} class="chart-svg" role="img" aria-label="Benchmarks with visual transitions improve; static perception and general video QA do not">
          <rect x={PL} y={PT - 6} width={midX - PL} height={plotH + 6} class="bg-trans" />
          <rect x={midX} y={PT - 6} width={CW - PR - midX} height={plotH + 6} class="bg-stat" />
          {[0, 5, 10, 20].map((t) => (<g><line x1={PL} x2={CW - PR} y1={y4(t)} y2={y4(t)} class={t === 0 ? 'zero' : 'grid'} /><text x={PL - 8} y={y4(t) + 4} class="tick">{t}</text></g>))}
          <line x1={PL} x2={CW - PR} y1={y4(2)} y2={y4(2)} class="thr" />
          <text x={PL - 8} y={y4(2) + 4} class="tick thr-t">2</text>
          {dots4.map((d) => (<circle cx={d.cx} cy={d.cy} r="5" class={d.st ? 'dot4 st' : 'dot4'}><title>{`${d.b}: ${fmt(d.d)}`}</title></circle>))}
          <text x={colX[0]} y={PT + plotH + 20} class="grp trans"><tspan x={colX[0]}>22 benchmarks with</tspan><tspan x={colX[0]} dy="14">visual transitions</tspan></text>
          <text x={colX[1]} y={PT + plotH + 20} class="grp stat"><tspan x={colX[1]}>Static perception,</tspan><tspan x={colX[1]} dy="14">general video QA</tspan></text>
          <text transform={`translate(16 ${PT + plotH / 2}) rotate(-90)`} class="ytitle">Gain (points, log scale)</text>
        </svg>
      </figure>
    </div>

    <p class="prospective"><strong>Prospective validation.</strong> Training data selected by the recipe outperforms alternative mixtures of the same size on multiple held-out benchmarks. See <a href="https://arxiv.org/abs/2610.12417" target="_blank" rel="noopener">our paper</a> for details.</p>

  </div>
</details>

<style>
  .rule { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 1.4rem 2rem; align-items: center; padding: 1.4rem 0; border-bottom: 1px solid #eef1f6; }
  .rule-text { display: flex; flex-direction: column; gap: 0.45rem; }
  .rhead { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .rflag { font-size: 1rem; font-weight: 700; color: #2453c4; background: #eaf0fd; border-radius: 10px; padding: 0.3rem 0.8rem; line-height: 1.35; }
  .rn { width: 30px; height: 30px; border-radius: 50%; background: #1c2a5a; color: #fff; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; font-size: 0.95rem; }
  .rt { font-size: 1.08rem; font-weight: 700; color: #14213a; line-height: 1.35; }
  .rx { font-size: 0.95rem; line-height: 1.6; color: #3a4558; }
  .rule-fig { margin: 0; }
  .rule-fig img { width: 100%; height: auto; border-radius: 8px; border: 1px solid #eef1f6; }
  .rule-fig figcaption { margin-top: 0.5rem; font-size: 0.85rem; line-height: 1.5; color: #556; }
  .chart-svg { width: 100%; height: auto; display: block; }
  .grid { stroke: #eef1f6; stroke-width: 1; }
  .zero { stroke: #9aa3b2; stroke-width: 1; }
  .tick { font-size: 11px; fill: #7d8798; text-anchor: end; }
  .bar2 { fill: #2453c4; }
  .val { font-size: 12px; font-weight: 700; fill: #1c2a5a; text-anchor: middle; }
  .xl { font-size: 11.5px; fill: #3a4558; text-anchor: middle; }
  .axl { font-size: 11.5px; font-weight: 600; fill: #7d8798; text-anchor: middle; }
  .axl-left { font-size: 11px; font-weight: 600; fill: #7d8798; }
  .axis-arrow { stroke: #7d8798; stroke-width: 1.5; }
  .thr { stroke: #c0392b; stroke-width: 1; stroke-dasharray: 4 3; opacity: 0.7; }
  .dot4 { fill: #2453c4; fill-opacity: 0.9; stroke: #fff; stroke-width: 1.2; }
  .dot4.st { fill: #8a94a6; }
  .bg-trans { fill: #edf2fd; }
  .bg-stat { fill: #f2f3f6; }
  .grp { font-size: 12px; font-weight: 700; text-anchor: middle; }
  .grp.trans { fill: #2453c4; }
  .grp.stat { fill: #6b7486; }
  .thr-t { fill: #c0392b; }
  .ytitle { font-size: 11px; font-weight: 600; fill: #7d8798; text-anchor: middle; }
  .b-row { font-size: 11px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; fill: #7d8798; }
  .bx { stroke-width: 1.2; }
  .bx.tmp { fill: #e7f5ef; stroke: #0f8a6a; }
  .bx.oth { fill: #f2f4f8; stroke: #c9d0dc; }
  .bx.endo { fill: #e6edfc; stroke: #2453c4; }
  .bx.exo { fill: #fdf1e6; stroke: #c2660a; }
  .bx-t { font-size: 16px; font-weight: 700; fill: #1c2a5a; text-anchor: middle; }
  .bx-t.tmp { fill: #0b6b52; }
  .bx-t.endo { fill: #1c3f99; }
  .bx-t.exo { fill: #8a4a0a; }
  .bx-s { font-size: 11px; fill: #556; text-anchor: middle; }
  .b-arrow { stroke: #a3acbb; stroke-width: 2.5; }
  .b-x { fill: #fff; stroke: #b42318; stroke-width: 2; }
  .b-xm { stroke: #b42318; stroke-width: 2.6; stroke-linecap: round; }
  .prospective { margin: 1.4rem 0 0; padding: 0.9rem 1.1rem; background: #f4f7fe; border: 1px solid #dfe6f7; border-radius: 10px; font-size: 0.98rem !important; color: #2b3447 !important; }
  .prospective a { color: #2453c4; font-weight: 600; }
  @media (max-width: 860px) { .rule { grid-template-columns: 1fr; } }
</style>
